<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mawuya.core.mapper.BlogInfoMapper">

    <resultMap id="BlogInfoMap" type="com.mawuya.core.dataobject.BlogDO">
        <id     property="id"           column="id"/>
        <result property="bloggerName"  column="blogger_name"/>
        <result property="themeCode"    column="theme_code"/>
    </resultMap>

    <select id="selectSingleton" resultMap="BlogInfoMap">
        SELECT id, blogger_name, theme_code
        FROM blog_info
        WHERE id = 1
        LIMIT 1
    </select>

    <update id="updateThemeCode">
        UPDATE blog_info
        SET theme_code = #{themeCode}
        WHERE id = 1
    </update>

</mapper>
