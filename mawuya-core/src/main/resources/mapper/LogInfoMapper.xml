<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.niudeyapi.mawuya.core.mapper.LogInfoMapper">

    <sql id="_columns">
        sn,ip_addr,country,province,city,area,detail_position,isp,try_times,req_time,resp_time,consume_time,req_url,req_method,params,browser,req_headers,resp_status,except_message
    </sql>

    <insert id="insert" parameterType="com.niudeyapi.mawuya.core.dataobject.LogDO">
        INSERT INTO log_info (ip_addr,country,province,city,area,detail_position,isp,try_times,req_time,resp_time,consume_time,req_url,req_method,params,browser,req_headers,resp_status,except_message)
        VALUES (#{ipAddr},#{country},#{province},#{city},#{area},#{detailPosition},#{isp},#{tryTimes},#{reqTime},#{respTime},#{consumeTime},#{reqUrl},#{reqMethod},#{params},#{browser},#{reqHeaders},#{respStatus},#{exceptMessage})
    </insert>

    <insert id="insertBatch" parameterType="list">
        INSERT INTO log_info(ip_addr,country,province,city,area,detail_position,isp,try_times,req_time,resp_time,consume_time,req_url,req_method,params,browser,req_headers,resp_status,except_message)
        VALUES
        <foreach collection="list" item="item" index="index" separator=",">
            (
            #{item.ipAddr},
            #{item.country},
            #{item.province},
            #{item.city},
            #{item.area},
            #{item.detailPosition},
            #{item.isp},
            #{item.tryTimes},
            #{item.reqTime},
            #{item.respTime},
            #{item.consumeTime},
            #{item.reqUrl},
            #{item.reqMethod},
            #{item.params},
            #{item.browser},
            #{item.reqHeaders},
            #{item.respStatus},
            #{item.exceptMessage}
            )
        </foreach>
    </insert>

    <delete id="deleteById" parameterType="int">
        DELETE FROM log_info WHERE sn = #{value}
    </delete>

    <update id="update" parameterType="com.niudeyapi.mawuya.core.dataobject.LogDO">
        UPDATE log_info SET 1 = 1 WHERE sn = #{sn}
    </update>

    <select id="selectById" parameterType="int" resultType="com.niudeyapi.mawuya.core.dataobject.LogDO">
        SELECT <include refid="_columns"/> FROM log_info WHERE sn = #{value}
    </select>

    <select id="selectList" parameterType="map" resultType="com.niudeyapi.mawuya.core.dataobject.LogDO">
        SELECT <include refid="_columns"/> FROM log_info
    </select>

    <select id="selectByPage" parameterType="map" resultType="com.niudeyapi.mawuya.core.dataobject.LogDO">
        SELECT <include refid="_columns"/> FROM log_info
        <if test="@com.niudeyapi.mawuya.common.utils.StrUtil@isAllNoEmpty(start,limit)">
            LIMIT #{start},#{limit}
        </if>
    </select>

    <select id="selectCount" parameterType="map" resultType="int">
        SELECT count(sn) FROM log_info
    </select>

    <!--
      多条件 + 时间范围 + 排序的分页查询。
      安全要点：
        1) 所有过滤条件均使用 #{} 参数化绑定；模糊匹配通过 CONCAT('%', x, '%') 拼装；
        2) order by 用 ${q.orderField} ${q.orderDir}，但这两个字段已由 service 层
           做白名单收敛（仅允许下表枚举），不存在 SQL 注入空间；若空则走默认排序。
    -->
    <select id="selectByConditionPage" resultType="com.niudeyapi.mawuya.core.dataobject.LogDO">
        SELECT <include refid="_columns"/> FROM log_info
        <where>
            <if test="q.ipAddr != null and q.ipAddr != ''">
                AND ip_addr LIKE CONCAT('%', #{q.ipAddr}, '%')
            </if>
            <if test="q.reqUrl != null and q.reqUrl != ''">
                AND req_url LIKE CONCAT('%', #{q.reqUrl}, '%')
            </if>
            <if test="q.reqMethod != null and q.reqMethod != ''">
                AND req_method = #{q.reqMethod}
            </if>
            <if test="q.respStatus != null and q.respStatus != ''">
                AND resp_status = #{q.respStatus}
            </if>
            <if test="q.country != null and q.country != ''">
                AND country = #{q.country}
            </if>
            <if test="q.province != null and q.province != ''">
                AND province LIKE CONCAT('%', #{q.province}, '%')
            </if>
            <if test="q.startTime != null and q.startTime != ''">
                AND req_time >= #{q.startTime}
            </if>
            <if test="q.endTime != null and q.endTime != ''">
                AND req_time &lt;= #{q.endTime}
            </if>
        </where>
        <choose>
            <when test="q.orderField != null and q.orderField != '' and q.orderDir != null and q.orderDir != ''">
                ORDER BY ${q.orderField} ${q.orderDir}
            </when>
            <otherwise>
                ORDER BY sn DESC
            </otherwise>
        </choose>
        <if test="q.limit != null">
            LIMIT
            <if test="q.offset != null">#{q.offset},</if>
            #{q.limit}
        </if>
    </select>

    <select id="countByCondition" resultType="int">
        SELECT count(sn) FROM log_info
        <where>
            <if test="q.ipAddr != null and q.ipAddr != ''">
                AND ip_addr LIKE CONCAT('%', #{q.ipAddr}, '%')
            </if>
            <if test="q.reqUrl != null and q.reqUrl != ''">
                AND req_url LIKE CONCAT('%', #{q.reqUrl}, '%')
            </if>
            <if test="q.reqMethod != null and q.reqMethod != ''">
                AND req_method = #{q.reqMethod}
            </if>
            <if test="q.respStatus != null and q.respStatus != ''">
                AND resp_status = #{q.respStatus}
            </if>
            <if test="q.country != null and q.country != ''">
                AND country = #{q.country}
            </if>
            <if test="q.province != null and q.province != ''">
                AND province LIKE CONCAT('%', #{q.province}, '%')
            </if>
            <if test="q.startTime != null and q.startTime != ''">
                AND req_time >= #{q.startTime}
            </if>
            <if test="q.endTime != null and q.endTime != ''">
                AND req_time &lt;= #{q.endTime}
            </if>
        </where>
    </select>

    <!--
      日志清理：定时任务专用，按 req_time 字符串比较 + idx_log_req_time 索引，分批 LIMIT 删除。
      安全要点：
        1) reqTimeBefore 由后端拼装（now - retainDays），不接受外部入参，无注入风险；
        2) LIMIT 由配置项 batch-size 控制（默认 1000），service 层做了上下界收敛；
        3) MySQL 不支持 DELETE ... ORDER BY req_time LIMIT 时若无显式 ORDER BY 也允许，
           这里加 ORDER BY req_time ASC 让每批删到最旧的一批，配合索引扫描更可控。
    -->
    <delete id="deleteOlderThan">
        DELETE FROM log_info
        WHERE req_time &lt; #{reqTimeBefore}
        ORDER BY req_time ASC
        LIMIT #{limit}
    </delete>

    <select id="countOlderThan" resultType="int">
        SELECT count(sn) FROM log_info WHERE req_time &lt; #{reqTimeBefore}
    </select>

</mapper>
