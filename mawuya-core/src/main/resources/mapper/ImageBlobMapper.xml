<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qihuizhong.mawuya.core.mapper.ImageBlobMapper">

    <resultMap id="metaMap" type="com.qihuizhong.mawuya.core.dataobject.ImageDO">
        <id property="sn" column="sn"/>
        <result property="fileName"     column="file_name"/>
        <result property="contentType"  column="content_type"/>
        <result property="byteSize"     column="byte_size"/>
        <result property="sha256"       column="sha256"/>
        <result property="sourceUrl"    column="source_url"/>
        <result property="createdTime"  column="created_time"/>
    </resultMap>

    <resultMap id="fullMap" type="com.qihuizhong.mawuya.core.dataobject.ImageDO" extends="metaMap">
        <result property="data" column="data"/>
    </resultMap>

    <insert id="insert" parameterType="com.qihuizhong.mawuya.core.dataobject.ImageDO"
            useGeneratedKeys="true" keyProperty="sn">
        INSERT INTO image_blob (file_name, content_type, byte_size, data, sha256, source_url)
        VALUES (#{fileName}, #{contentType}, #{byteSize}, #{data}, #{sha256}, #{sourceUrl})
    </insert>

    <select id="selectMetaById" resultMap="metaMap">
        SELECT sn, file_name, content_type, byte_size, sha256, source_url, created_time
        FROM image_blob WHERE sn = #{sn}
    </select>

    <select id="selectFullById" resultMap="fullMap">
        SELECT sn, file_name, content_type, byte_size, data, sha256, source_url, created_time
        FROM image_blob WHERE sn = #{sn}
    </select>

    <select id="selectBySha256" resultMap="metaMap">
        SELECT sn, file_name, content_type, byte_size, sha256, source_url, created_time
        FROM image_blob WHERE sha256 = #{sha256} LIMIT 1
    </select>

    <select id="selectSnBySourceUrl" resultType="java.lang.Long">
        SELECT sn FROM image_blob WHERE source_url = #{sourceUrl} LIMIT 1
    </select>

    <select id="listMeta" resultMap="metaMap">
        SELECT sn, file_name, content_type, byte_size, sha256, source_url, created_time
        FROM image_blob
        ORDER BY sn DESC
        <if test="limit != null">
            LIMIT
            <if test="offset != null">#{offset},</if>
            #{limit}
        </if>
    </select>

    <select id="countAll" resultType="int">
        SELECT COUNT(*) FROM image_blob
    </select>

    <!--
      按 file_name 模糊匹配（参数化绑定，CONCAT 拼接通配符，无 SQL 注入）。
      keyword 为 null 或空白时退化为全表查询，与 listMeta 行为一致。
    -->
    <select id="listMetaByKeyword" resultMap="metaMap">
        SELECT sn, file_name, content_type, byte_size, sha256, source_url, created_time
        FROM image_blob
        <where>
            <if test="keyword != null and keyword != ''">
                file_name LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
        ORDER BY sn DESC
        <if test="limit != null">
            LIMIT
            <if test="offset != null">#{offset},</if>
            #{limit}
        </if>
    </select>

    <select id="countByKeyword" resultType="int">
        SELECT COUNT(*) FROM image_blob
        <where>
            <if test="keyword != null and keyword != ''">
                file_name LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
    </select>

    <delete id="deleteById">
        DELETE FROM image_blob WHERE sn = #{sn}
    </delete>

</mapper>
