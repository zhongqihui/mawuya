<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qihuizhong.mawuya.core.mapper.CategoryMapper">

    <sql id="_columns">
        sn,category_name
    </sql>

    <insert id="insert" parameterType="com.qihuizhong.mawuya.core.dataobject.CategoryDO">
        INSERT INTO category_info (category_name) VALUES (#{categoryName})
    </insert>

    <delete id="deleteById" parameterType="int">
        DELETE FROM category_info WHERE sn = #{value}
    </delete>

    <update id="update" parameterType="com.qihuizhong.mawuya.core.dataobject.CategoryDO">
        UPDATE category_info SET category_name = #{categoryName} WHERE sn = #{sn}
    </update>

    <select id="selectById" parameterType="int" resultType="com.qihuizhong.mawuya.core.dataobject.CategoryDO">
        SELECT <include refid="_columns"/> FROM category_info WHERE sn = #{value}
    </select>

    <select id="selectList" parameterType="map" resultType="com.qihuizhong.mawuya.core.dataobject.CategoryDO">
        SELECT <include refid="_columns"/> FROM category_info ORDER BY sn DESC
    </select>

    <select id="selectByPage" parameterType="map" resultType="com.qihuizhong.mawuya.core.dataobject.CategoryDO">
        SELECT <include refid="_columns"/> FROM category_info
        <if test="@com.qihuizhong.mawuya.common.utils.StrUtil@isAllNoEmpty(start,limit)">
            LIMIT #{start},#{limit}
        </if>
    </select>

    <select id="selectCount" parameterType="map" resultType="int">
        SELECT count(sn) FROM category_info
    </select>

</mapper>
