# ===================================================================
# Mawuya 部署脚本环境配置示例
# 复制为 deploy.env 后按需修改；deploy.env 已 chmod 600 自动生成。
# 不要把密码写进版本库！
# ===================================================================

# 远端 SSH 信息（密码请通过交互输入，避免落盘）
export SSH_HOST=""
export SSH_PORT="22"
export SSH_USER="root"

# 远端部署目录（脚本会创建在此目录下）
export REMOTE_DEPLOY_DIR="/usr/local/services/mawuya"

# 端口
export AMS_PORT="8080"
export BMS_PORT="8081"
export MYSQL_PORT="3306"

# MySQL（容器版）默认账号
export MYSQL_ROOT_PASSWORD="ChangeMe_Root_2026"
export MYSQL_DATABASE="blog"
export MYSQL_USER="mawuya"
export MYSQL_PASSWORD="ChangeMe_App_2026"
